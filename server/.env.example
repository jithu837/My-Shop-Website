# Rename this file to .env before running the server

# MongoDB connection string (MongoDB Atlas or local)
# Render needs a hosted MongoDB connection string, such as MongoDB Atlas.
# MongoDB Atlas URI. Set the real value in server/.env or Render Environment.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chamundeshwari
# Port the API server runs on
PORT=5000

# Razorpay server credentials
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
