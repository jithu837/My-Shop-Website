# ─── Backend API ────────────────────────────────────────────────────────────
# Your live backend URL on Render (no trailing slash).
# Leave EMPTY in development — Vite proxy forwards /api to localhost:5000.
VITE_API_URL=

# ─── UPI Payment Details ────────────────────────────────────────────────────
# Your UPI ID (the one customers will pay to)
VITE_UPI_ID=yourname@bankname

# Your name as it appears on UPI apps
VITE_UPI_PAYEE_NAME=YOUR FULL NAME

# Short shop name shown in UPI payment description
VITE_SHOP_NAME=Your Shop Name
VITE_RAZORPAY_KEY_ID=rzp_your_key_id
